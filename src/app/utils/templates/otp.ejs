<div
  style="
    font-family: Arial, sans-serif;
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
  "
>
  <div style="text-align: center; margin-bottom: 20px">
    <h2 style="color: #333333">OTP Verification</h2>
    <p style="color: #555555; font-size: 16px">Hello <%= name %>,</p>
  </div>

  <div
    style="
      background-color: #f9f9f9;
      padding: 25px;
      border-radius: 6px;
      text-align: center;
      margin-bottom: 20px;
    "
  >
    <p style="color: #555555; font-size: 18px">
      Your one-time password (OTP) is:
    </p>
    <div
      style="
        background-color: #ffffff;
        border: 2px dashed #007bff;
        padding: 15px;
        border-radius: 4px;
        display: inline-block;
        margin-top: 10px;
      "
    >
      <h1
        style="color: #007bff; font-size: 32px; letter-spacing: 5px; margin: 0"
      >
        <strong><%= otp %></strong>
      </h1>
    </div>
    <p style="color: #777777; font-size: 14px; margin-top: 20px">
      This code is valid for 2 minutes.
    </p>
  </div>

  <div style="text-align: center; margin-top: 30px">
    <p style="color: #888888; font-size: 12px">
      If you didn't request this code, please ignore this email.
    </p>
  </div>
</div>
